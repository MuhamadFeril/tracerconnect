[TEMPLATE]
# Login Google kini memakai flow OAuth server-side (backend Laravel):
# klik tombol -> redirect ke akun chooser Google -> backend tukar code ->
# token Sanctum dikirim ke /google/callback. Frontend tidak lagi butuh
# VITE_GOOGLE_CLIENT_ID — cukup konfigurasi di backend/.env:
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REDIRECT_URI
# dan daftarkan GOOGLE_REDIRECT_URI sebagai "Authorized redirect URIs"
# pada OAuth Client di Google Cloud Console.
